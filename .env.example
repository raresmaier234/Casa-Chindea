# ══════════════════════════════════════════════════════════════════
# Casa Chindea — Variabile de Mediu
# Copiază acest fișier în .env.local (dev) sau setează în platforma
# de deployment (Render / Fly.io secrets) pentru producție.
# ══════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────
PORT=3001
# development | production
NODE_ENV=development

# ── PocketBase ────────────────────────────────────────────────────
# DEV: http://127.0.0.1:8090
# PROD: https://casa-chindea.fly.dev
POCKET_BASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=your-strong-password-here

# ── JWT ───────────────────────────────────────────────────────────
# Generează cu: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-hex

# ── Email / SMTP ──────────────────────────────────────────────────
# Gmail: activează "Parole de aplicație" în Contul Google
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password-16-chars
# Email unde sosesc mesajele de contact
CONTACT_TO=gazda@example.com

# ── WhatsApp Business (Meta Cloud API) ───────────────────────────
# Găsești în: Meta Business Suite → WhatsApp → API Setup
WHATSAPP_PHONE_ID=954564601075414
# Token de acces permanent (generat în Meta Developer App)
WHATSAPP_TOKEN=your-permanent-whatsapp-token

# Facebook App (pentru reîmprospătarea automată a token-ului)
# Găsești în: developers.facebook.com → App → Settings → Basic
FB_APP_ID=your-facebook-app-id
FB_APP_SECRET=your-facebook-app-secret

# Numărul de telefon al GAZDEI (format: 40XXXXXXXXX fără +)
# Toate notificările de rezervare nouă merg aici
OWNER_WHATSAPP_PHONE=40744308651

# Numărul de contact afișat pe site (poate fi același cu OWNER_WHATSAPP_PHONE)
CONTACT_PHONE=+40744308651

# ── Doar DEV: redirecționează mesajele WA ale clientului la acest număr ──
# Dacă e setat, mesajele de confirmare/respingere NU merg la clientul real
# Lasă gol în producție!
TEST_WHATSAPP_PHONE=

# ── Google reCAPTCHA v2 ───────────────────────────────────────────
# Generează pe: https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET=your-recaptcha-secret

# ── URL-uri ───────────────────────────────────────────────────────
# DEV: http://localhost:3001 | PROD: https://api.casachindea.ro
API_URL=http://localhost:3001
# DEV: http://localhost:8080 | PROD: https://casachindea.ro
FRONTEND_URL=http://localhost:8080

# Vite (frontend build)
VITE_API_URL=http://localhost:3001
VITE_POCKET_BASE_URL=http://127.0.0.1:8090

# ── Auth0 (opțional) ─────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com

