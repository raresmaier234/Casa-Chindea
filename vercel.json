{
    "version": 2,
    "public": true,
    "buildCommand": null,
    "installCommand": null,
    "outputDirectory": "public",
    "framework": null,
    "functions": {},
    "routes": [],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://casa-chindea.onrender.com/api/:path*"
        },
        {
            "source": "/",
            "destination": "/index.html"
        },
        {
            "source": "/js/pages/:match*",
            "destination": "/js/pages/:match*"
        },
        {
            "source": "/js/components/:match*",
            "destination": "/js/components/:match*"
        },
        {
            "source": "/favicon.ico",
            "destination": "/favicon.ico"
        },
        {
            "source": "/vite.svg",
            "destination": "/vite.svg"
        },
        {
            "source": "/javascript.svg",
            "destination": "/javascript.svg"
        }
    ],
    "headers": [
        {
            "source": "/js/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, immutable"
                }
            ]
        },
        {
            "source": "/(.*).html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*).webp",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}