{
    "version": 2,
    "buildCommand": "",
    "outputDirectory": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "framework": null,
    "routes": [
        { "src": "/home", "headers": { "Location": "/" }, "status": 301 },
        { "src": "/home.html", "headers": { "Location": "/" }, "status": 301 },
        { "src": "/api/(.*)", "dest": "https://api.casachindea.ro/api/$1" },
        { "handle": "filesystem" },
        { "src": "^/$", "dest": "/home.html" },
        { "src": "/(.*)", "headers": { "Location": "/" }, "status": 302 }

    ]
}