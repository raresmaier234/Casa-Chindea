{
    "version": 2,
    "buildCommand": "",
    "outputDirectory": "public",
    "trailingSlash": false,
    "framework": null,
    "routes": [
        { "src": "/home", "headers": { "Location": "/" }, "status": 301 },
        { "src": "/home.html", "headers": { "Location": "/" }, "status": 301 },
        { "src": "/api/(.*)", "dest": "https://api.casachindea.ro/api/$1" },
        { "src": "^/$", "dest": "/home.html" },
        { "src": "^/about$", "dest": "/about.html" },
        { "src": "^/admin$", "dest": "/admin.html" },
        { "src": "^/booking$", "dest": "/booking.html" },
        { "src": "^/contact$", "dest": "/contact.html" },
        { "src": "^/gallery$", "dest": "/gallery.html" },
        { "src": "^/login$", "dest": "/login.html" },
        { "src": "^/offers$", "dest": "/offers.html" },
        { "src": "^/privacy$", "dest": "/privacy.html" },
        { "src": "^/profile$", "dest": "/profile.html" },
        { "src": "^/register$", "dest": "/register.html" },
        { "src": "^/reset-password$", "dest": "/reset-password.html" },
        { "src": "^/terms$", "dest": "/terms.html" },
        { "src": "^/verify-email$", "dest": "/verify-email.html" },
        { "src": "^/404$", "dest": "/404.html" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/home.html" }
    ]
}