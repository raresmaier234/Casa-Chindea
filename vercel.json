{
    "version": 2,
    "buildCommand": null,
    "installCommand": null,
    "outputDirectory": "public",
    "framework": null,
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
        { "source": "/home", "destination": "/", "permanent": true },
        {
            "source": "/((?!$|about$|offers$|gallery$|booking$|contact$|login$|register$|profile$|admin$|privacy$|terms$|verify-email$|reset-password$|js/.*|css/.*|api/.*|sitemap\\.xml$|robots\\.txt$|favicon\\.ico$|favicon\\.svg$|vite\\.svg$|googlef1ee2b5187cf8079\\.html$|.*\\.html$).*)",
            "destination": "/",
            "permanent": true
        }
    ],
    "rewrites": [
        { "source": "/", "destination": "/home.html" },
        { "source": "/about", "destination": "/about.html" },
        { "source": "/offers", "destination": "/offers.html" },
        { "source": "/gallery", "destination": "/gallery.html" },
        { "source": "/booking", "destination": "/booking.html" },
        { "source": "/contact", "destination": "/contact.html" },
        { "source": "/login", "destination": "/login.html" },
        { "source": "/register", "destination": "/register.html" },
        { "source": "/profile", "destination": "/profile.html" },
        { "source": "/admin", "destination": "/admin.html" },
        { "source": "/privacy", "destination": "/privacy.html" },
        { "source": "/terms", "destination": "/terms.html" },
        { "source": "/verify-email", "destination": "/verify-email.html" },
        { "source": "/reset-password", "destination": "/reset-password.html" },
        {
            "source": "/api/:path*",
            "destination": "https://api.casachindea.ro/api/:path*"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains; preload"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(self)"
                }
            ]
        },
        {
            "source": "/js/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, immutable"
                }
            ]
        },
        {
            "source": "/(.*).html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*).webp",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}