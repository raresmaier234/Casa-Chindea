{
    "version": 2,
    "buildCommand": null,
    "installCommand": null,
    "outputDirectory": "public",
    "framework": null,
    "rewrites": [
        {
            "source": "/",
            "destination": "/js/pages/home.html"
        },
        {
            "source": "/index.html",
            "destination": "/js/pages/home.html"
        },
        {
            "source": "/home",
            "destination": "/js/pages/home.html"
        },
        {
            "source": "/about",
            "destination": "/js/pages/about.html"
        },
        {
            "source": "/gallery",
            "destination": "/js/pages/gallery.html"
        },
        {
            "source": "/booking",
            "destination": "/js/pages/booking.html"
        },
        {
            "source": "/contact",
            "destination": "/js/pages/contact.html"
        },
        {
            "source": "/offers",
            "destination": "/js/pages/offers.html"
        },
        {
            "source": "/api/:path*",
            "destination": "https://api.casachindea.ro/api/:path*"
        },
        {
            "source": "/js/pages/:match*",
            "destination": "/js/pages/:match*"
        },
        {
            "source": "/js/components/:match*",
            "destination": "/js/components/:match*"
        },
        {
            "source": "/favicon.ico",
            "destination": "/favicon.ico"
        },
        {
            "source": "/vite.svg",
            "destination": "/vite.svg"
        },
        {
            "source": "/javascript.svg",
            "destination": "/javascript.svg"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains; preload"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(self)"
                }
            ]
        },
        {
            "source": "/js/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, immutable"
                }
            ]
        },
        {
            "source": "/(.*).html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*).webp",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}