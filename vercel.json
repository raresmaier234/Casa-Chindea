{
    "version": 2,
    "functions": {
        "api/index.js": {
            "runtime": "nodejs18.x"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/",
            "destination": "/index.html"
        },
        {
            "source": "/js/pages/:match*",
            "destination": "/js/pages/:match*"
        },
        {
            "source": "/js/components/:match*",
            "destination": "/js/components/:match*"
        }
    ],
    "builds": [
        {
            "src": "api/index.js",
            "use": "@vercel/node"
        },
        {
            "src": "public/**/*",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/index.js"
        },
        {
            "src": "/(.*)",
            "dest": "/public/$1"
        }
    ]
}